{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!node_modules", "!.next", "!dist", "!build"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "tab",
    "indentWidth": 2,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true,
      "cssModules": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "performance": {
        "noBarrelFile": "error"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "gsap": "Importuj GSAP z @/shared/lib/gsap (rejestracja pluginów, docs/ARCHITECTURE.md A4)."
            },
            "patterns": [
              {
                "group": ["@/features/*", "!@/features/*/**"],
                "message": "Importuj bezpośrednio z pliku warstwy, nie z korzenia feature'a (docs/ARCHITECTURE.md A7)."
              }
            ]
          }
        }
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**/components/*/index.ts", "src/shared/lib/utils.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": ["src/shared/lib/gsap.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          },
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": ["src/features/*/utils/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "gsap": "Importuj GSAP z @/shared/lib/gsap (rejestracja pluginów, docs/ARCHITECTURE.md A4)."
                },
                "patterns": [
                  {
                    "group": ["@/features/*", "!@/features/*/**"],
                    "message": "Importuj bezpośrednio z pliku warstwy, nie z korzenia feature'a (docs/ARCHITECTURE.md A7)."
                  },
                  {
                    "group": ["**/components/**"],
                    "message": "utils/ nie importuje components/ (docs/ARCHITECTURE.md A4)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/*/model/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "gsap": "Importuj GSAP z @/shared/lib/gsap (rejestracja pluginów, docs/ARCHITECTURE.md A4)."
                },
                "patterns": [
                  {
                    "group": ["@/features/*", "!@/features/*/**"],
                    "message": "Importuj bezpośrednio z pliku warstwy, nie z korzenia feature'a (docs/ARCHITECTURE.md A7)."
                  },
                  {
                    "group": ["**/components/**", "**/utils/**"],
                    "message": "model/ nie importuje components/ ani utils/ (docs/ARCHITECTURE.md A4)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/**", "!src/shared/lib/gsap.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "gsap": "Importuj GSAP z @/shared/lib/gsap (rejestracja pluginów, docs/ARCHITECTURE.md A4)."
                },
                "patterns": [
                  {
                    "group": ["@/features/**"],
                    "message": "shared/ nie importuje niczego z features/ (docs/ARCHITECTURE.md A4)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
